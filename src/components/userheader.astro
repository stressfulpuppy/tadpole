---
import UserPopup from "./userpopup.astro";
import { UserRound } from "@lucide/astro";
import { getAvatarUrl, type Session } from "../server/session";

interface Props {
  session?: Session | null;
}

const { session } = Astro.props;
const avatarUrl = session ? getAvatarUrl(session, 64) : null;
const isLoginPage = Astro.url.pathname === "/login";
---

<header class="flex w-full items-center justify-end px-4 pt-3 sm:px-6">
  <div class="absolute translate-y-4">
    <!-- changed from relative to absolute because it was annoying me when i tried to put a page title for admin -->
    {session ? (
      <button
        id="userContext"
        type="button"
        aria-haspopup="menu"
        aria-expanded="false"
        class="flex items-center gap-2.5 rounded-lg p-1.5 pl-2.5 pr-1.5 transition-colors hover:bg-ctp-surface0"
      >
        <span class="flex flex-col justify-center text-right leading-tight">
          <span class="text-sm font-semibold text-ctp-text">@{session.username ?? "user"}</span>
          <span class="mt-0.5 text-xs font-normal text-ctp-subtext0">{session.role}</span>
        </span>
        <img
          src={avatarUrl}
          alt={`@${session.username ?? "user"}'s avatar`}
          class="h-10 w-10 rounded-full object-cover ring-1 ring-ctp-surface1"
        />
      </button>
    ) : (
      !isLoginPage && (
        <a
          href="/login"
          class="flex h-10 items-center gap-2 rounded-lg border border-ctp-surface1 bg-ctp-surface0 px-3 text-sm text-ctp-text transition-colors hover:border-ctp-overlay0 hover:bg-ctp-surface1"
        >
          <UserRound class="h-4 w-4" />
          <span>log in</span>
        </a>
      )
    )}

    {session && <UserPopup session={session} />}
  </div>
</header>
