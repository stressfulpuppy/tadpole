---
import Main from "../layouts/main.astro";
import UserPopup from "../components/userpopup.astro";
import { BookOpen, ArrowUpRight, UserRound } from "@lucide/astro";
---

<Main title="tadpole">
  <div class="min-h-dvh bg-ctp-base font-jost font-medium text-ctp-text">
    <div class="absolute top-0 right-0 justify-items-end">
      <button
        id="userContext"
        class="flex gap-2 items-center top-4 mt-4 md:mt-0 rounded-lg hover:bg-ctp-surface2 md:min-w-0 min-w-42 md:p-6 z-10"
      >
        <div class="flex flex-col justify-end text-right">
          <span class="text-lg font-bold leading-tight text-ctp-text">@charlotte</span>
          <span class="mt-0.5 text-lg font-normal leading-tight text-ctp-subtext1">user</span>
        </div>
        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-ctp-surface0 text-ctp-subtext1 transition-colors hover:bg-ctp-surface1 sm:h-14 sm:w-14">
          <UserRound class="h-4.5 w-4.5 sm:h-8 sm:w-8" />
        </div>
      </button>

      <UserPopup />
    </div>

    <div class="flex min-h-dvh grow flex-col items-center justify-center px-5 pt-16 sm:px-8 sm:pt-12">
      <div class="flex flex-1 flex-col items-center justify-center text-center">
        <h1 class="bg-linear-50 bg-clip-text font-besley text-6xl font-bold italic leading-none tracking-tight text-transparent from-ctp-green to-ctp-teal sm:text-8xl lg:text-[9rem]">tadpole</h1>

        <p class="mt-4 max-w-xl text-base font-normal leading-relaxed text-ctp-subtext0 sm:mt-5 sm:text-xl lg:text-2xl">an open-source, self-hostable file server.</p>

        <div class="mt-6 flex w-full flex-col gap-3 text-ctp-subtext1 sm:mt-7 sm:w-auto sm:flex-row sm:gap-3">
          <a
            href="rules"
            class="flex h-11 w-full items-center justify-center gap-2 rounded-lg border border-ctp-surface1 bg-ctp-surface0 px-4 text-center transition-colors hover:border-ctp-overlay0 hover:bg-ctp-surface1 sm:w-40"
          >
            <BookOpen class="h-4.25 w-4.25" />
            <span>instance rules</span>
          </a>

          <a
            href="upload"
            class="flex h-11 w-full items-center justify-center gap-2 rounded-lg border border-ctp-surface1 bg-ctp-surface0 px-4 text-center transition-colors hover:border-ctp-overlay0 hover:bg-ctp-surface1 sm:w-40"
          >
            <ArrowUpRight class="h-4.25 w-4.25" />
            <span>upload files...</span>
          </a>
        </div>
      </div>

      <footer class="w-full pb-2 pt-3 text-center text-[11px] font-normal leading-relaxed text-ctp-subtext0 sm:pb-3 sm:pt-4 sm:text-xs">
        <p class="flex flex-wrap items-center justify-center md:text-base gap-x-1.5 gap-y-0.5">
          <span>running version</span>
          <a
            class="text-ctp-green underline-offset-4 transition-colors hover:text-ctp-teal hover:underline"
            href={HASH}
            target="_blank"
            rel="noopener noreferrer"
          >
            {VERSION}
          </a>
          <span class="text-ctp-overlay0">·</span>
          <span
            id="sumcount"
            class="font-medium text-ctp-text"
          >
            1,234
          </span>
          <span>files uploaded</span>
          <span class="text-ctp-overlay0">·</span>
          <span>using</span>
          <span
            id="sumsize"
            class="font-medium text-ctp-text"
          >
            56.78 GB
          </span>
        </p>

        <p class="mt-1 flex flex-wrap items-center md:text-sm justify-center gap-x-1.5 gap-y-0.5">
          <span>© 2026</span>
          <a
            href="https://github.com/stressfulpuppy/tadpole/graphs/contributors"
            target="_blank"
            rel="noopener noreferrer"
            class="text-ctp-green underline-offset-4 transition-colors hover:text-ctp-teal hover:underline"
          >
            tadpole contributors
          </a>
          <span class="text-ctp-overlay0">·</span>
          <span>for takedowns, please email</span>
          <a
            href="mailto:abuse@tadpole.rip"
            class="text-ctp-green underline-offset-4 transition-colors hover:text-ctp-teal hover:underline"
          >
            abuse@tadpole.rip
          </a>
        </p>
      </footer>
    </div>
  </div>
</Main>
