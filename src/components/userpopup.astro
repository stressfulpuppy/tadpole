---
import type { Session } from "../utils/session";

interface Props {
  session?: Session | null;
}

const { session } = Astro.props;
---

<div
  id="userContextMenu"
  class="absolute right-0 top-full mt-2 hidden w-48 rounded-xl bg-ctp-surface0 p-2"
>
  <ul>
    <li class="rounded-lg hover:bg-ctp-surface1">
      <a
        class="block px-2 py-1"
        href="/settings"
      >
        Account Settings
      </a>
    </li>
    <li class="rounded-lg hover:bg-ctp-surface1">
      <a
        class="block px-2 py-1"
        href="/uploads"
      >
        My Uploads
      </a>
    </li>
    {session?.role === "admin" && (
      <li class="rounded-lg hover:bg-ctp-surface1">
        <a
          class="block px-2 py-1"
          href="/admin"
        >
          Admin Panel
        </a>
      </li>
    )}
    <li class="my-1 border-t border-ctp-surface1"></li>
    <li class="rounded-lg text-ctp-red hover:bg-ctp-surface1">
      <a
        class="block px-2 py-1"
        href="/api/logout"
      >
        Log Out
      </a>
    </li>
  </ul>
</div>

<script is:inline>
  const userContextElement = document.getElementById("userContext");
  const userContextMenu = document.getElementById("userContextMenu");

  userContextElement?.addEventListener("click", (event) => {
    event.preventDefault();
    event.stopPropagation();
    userContextMenu?.classList.toggle("hidden");
  });

  document.addEventListener("click", (event) => {
    if (userContextMenu && !userContextMenu.contains(event.target) && !userContextElement?.contains(event.target)) {
      userContextMenu.classList.add("hidden");
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      userContextMenu?.classList.add("hidden");
    }
  });
</script>
