---
import { Settings, Images, ShieldCheck, LogOut } from "@lucide/astro";
import type { Session } from "../utils/session";

interface Props {
  session?: Session | null;
}

const { session } = Astro.props;
---

<div
  id="userContextMenu"
  role="menu"
  class="absolute right-0 top-full z-20 mt-2 hidden w-52 rounded-lg border border-ctp-surface1 bg-ctp-surface0 p-1.5 shadow-lg"
>
  <ul class="text-sm font-normal">
    <li>
      <a
        href="/settings"
        role="menuitem"
        class="flex items-center gap-2.5 rounded-md px-3 py-2 text-ctp-text transition-colors hover:bg-ctp-surface1"
      >
        <Settings class="h-4 w-4 shrink-0 text-ctp-subtext0" />
        <span>account settings</span>
      </a>
    </li>
    <li>
      <a
        href="/uploads"
        role="menuitem"
        class="flex items-center gap-2.5 rounded-md px-3 py-2 text-ctp-text transition-colors hover:bg-ctp-surface1"
      >
        <Images class="h-4 w-4 shrink-0 text-ctp-subtext0" />
        <span>my uploads</span>
      </a>
    </li>
    {session?.role === "admin" && (
      <li>
        <a
          href="/admin"
          role="menuitem"
          class="flex items-center gap-2.5 rounded-md px-3 py-2 text-ctp-text transition-colors hover:bg-ctp-surface1"
        >
          <ShieldCheck class="h-4 w-4 shrink-0 text-ctp-subtext0" />
          <span>admin panel</span>
        </a>
      </li>
    )}
    <li class="my-1 border-t border-ctp-surface1"></li>
    <li>
      <a
        href="/api/logout"
        role="menuitem"
        class="flex items-center gap-2.5 rounded-md px-3 py-2 text-ctp-red transition-colors hover:bg-ctp-surface1"
      >
        <LogOut class="h-4 w-4 shrink-0" />
        <span>log out</span>
      </a>
    </li>
  </ul>
</div>

<script is:inline>
  const userContextElement = document.getElementById("userContext");
  const userContextMenu = document.getElementById("userContextMenu");

  function setMenu(open) {
    userContextMenu?.classList.toggle("hidden", !open);
    userContextElement?.setAttribute("aria-expanded", String(open));
  }

  userContextElement?.addEventListener("click", (event) => {
    event.preventDefault();
    event.stopPropagation();
    setMenu(userContextMenu?.classList.contains("hidden") ?? false);
  });

  document.addEventListener("click", (event) => {
    if (userContextMenu && !userContextMenu.contains(event.target) && !userContextElement?.contains(event.target)) {
      setMenu(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });
</script>
