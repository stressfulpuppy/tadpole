<div
  id="userContextMenu"
  class="absolute right-0 top-full mt-2 hidden w-48 rounded-xl bg-ctp-surface0 p-2"
>
  <ul>
    <li class="rounded-lg hover:bg-ctp-surface1">
      <a
        class="block px-2 py-1"
        href="/settings"
      >
        Account Settings
      </a>
    </li>
    <li class="rounded-lg hover:bg-ctp-surface1">
      <a
        class="block px-2 py-1"
        href="/uploads"
      >
        My Uploads
      </a>
    </li>
    <li class="rounded-lg hover:bg-ctp-surface1">
      <a
        class="block px-2 py-1"
        href="/admin"
      >
        Admin Panel
      </a>
    </li>
  </ul>
</div>

<script>
  const userContextElement = document.getElementById("userContext");
  const userContextMenu = document.getElementById("userContextMenu");

  userContextElement?.addEventListener("click", (event) => {
    event.stopPropagation();
    userContextMenu?.classList.toggle("hidden");
  });

  document.addEventListener("click", (event) => {
    if (userContextMenu && !userContextMenu.contains(event.target as Node) && !userContextElement?.contains(event.target as Node)) {
      userContextMenu.classList.add("hidden");
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      userContextMenu?.classList.add("hidden");
    }
  });
</script>
