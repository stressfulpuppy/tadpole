---

<footer class="w-full pb-2 pt-3 text-center text-xs font-normal leading-relaxed text-ctp-subtext0 sm:pb-3 sm:pt-4 sm:text-sm">
  <p class="flex flex-wrap items-center justify-center gap-x-1.5 gap-y-0.5">
    <span>running version</span>
    <a
      class="text-ctp-green underline-offset-4 transition-colors hover:text-ctp-teal hover:underline"
      href={HASH}
      target="_blank"
      rel="noopener noreferrer"
    >
      {VERSION}
    </a>
    <span class="text-ctp-overlay0">·</span>
    <span
      id="sumcount"
      class="font-medium text-ctp-text"
    >
      1,234
    </span>
    <span>files uploaded</span>
    <span class="text-ctp-overlay0">·</span>
    <span>using</span>
    <span
      id="sumsize"
      class="font-medium text-ctp-text"
    >
      56.78 GB
    </span>
  </p>

  <p class="mt-1 flex flex-wrap items-center justify-center gap-x-1.5 gap-y-0.5">
    <span>© 2026</span>
    <a
      href="https://github.com/stressfulpuppy/tadpole/graphs/contributors"
      target="_blank"
      rel="noopener noreferrer"
      class="text-ctp-green underline-offset-4 transition-colors hover:text-ctp-teal hover:underline"
    >
      tadpole contributors
    </a>
    <span class="text-ctp-overlay0">·</span>
    <span>for takedowns, please email</span>
    <a
      href="mailto:abuse@tadpole.rip"
      class="text-ctp-green underline-offset-4 transition-colors hover:text-ctp-teal hover:underline"
    >
      abuse@tadpole.rip
    </a>
  </p>
</footer>
