---
import UserPopup from "./userpopup.astro";
import { UserRound } from "@lucide/astro";
import { getAvatarUrl, type Session } from "../utils/session";

interface Props {
  session?: Session | null;
}

const { session } = Astro.props;
const avatarUrl = session ? getAvatarUrl(session, 64) : null;
const isLoginPage = Astro.url.pathname === "/login";
---

<div class="absolute right-2 top-4 z-20">
  <div class="relative">
    {session ? (
      <button
        id="userContext"
        type="button"
        class="flex items-center gap-3 rounded-lg p-3 transition-colors hover:bg-ctp-surface0"
      >
        <div class="flex flex-col justify-center text-right">
          <span class="text-base font-semibold leading-tight text-ctp-text sm:text-lg">@{session.username ?? "user"}</span>
          <span class="mt-0.5 text-sm font-normal leading-tight text-ctp-subtext1">{session.role}</span>
        </div>
        <img
          src={avatarUrl}
          alt={`@${session.username ?? "user"}'s avatar`}
          class="h-11 w-11 rounded-full object-cover sm:h-12 sm:w-12"
        />
      </button>
    ) : isLoginPage ? (
      <div class="flex items-center gap-3 rounded-lg p-3 opacity-60">
        <div class="flex flex-col justify-center text-right">
          <span class="text-base font-semibold leading-tight text-ctp-text sm:text-lg">guest</span>
          <span class="mt-0.5 text-sm font-normal leading-tight text-ctp-subtext1">not logged in</span>
        </div>
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-ctp-surface0 text-ctp-subtext1 sm:h-12 sm:w-12">
          <UserRound class="h-6 w-6" />
        </div>
      </div>
    ) : (
      <a
        href="/login"
        class="flex items-center gap-3 rounded-lg p-3 transition-colors hover:bg-ctp-surface0"
      >
        <div class="flex flex-col justify-center text-right">
          <span class="text-base font-semibold leading-tight text-ctp-text sm:text-lg">guest</span>
          <span class="mt-0.5 text-sm font-normal leading-tight text-ctp-subtext1">click to login</span>
        </div>
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-ctp-surface0 text-ctp-subtext1 transition-colors hover:bg-ctp-surface1 sm:h-12 sm:w-12">
          <UserRound class="h-6 w-6" />
        </div>
      </a>
    )}

    {session && <UserPopup session={session} />}
  </div>
</div>
