---
import Main from "../layouts/main.astro";
import { BookOpen, ArrowUpRight } from "@lucide/astro";
---

<Main title="tadpole">
  <div class="flex w-full flex-1 flex-col items-center justify-center py-20 text-center">
    <h1 class="bg-linear-50 bg-clip-text pb-[0.12em] pr-[0.08em] font-besley text-6xl font-bold italic leading-none tracking-tight text-transparent from-ctp-green to-ctp-teal sm:text-8xl lg:text-[9rem]">tadpole</h1>

    <p class="mt-4 max-w-xl text-base font-normal leading-relaxed text-ctp-subtext0 sm:mt-5 sm:text-xl lg:text-2xl">an open-source, self-hostable file server.</p>

    <div class="mt-6 flex w-full flex-col gap-3 text-ctp-text sm:mt-7 sm:w-auto sm:flex-row sm:gap-3">
      <a
        href="rules"
        class="flex h-11 w-full items-center justify-center gap-2 rounded-lg border border-ctp-surface1 bg-ctp-surface0 px-4 text-center transition-colors hover:border-ctp-overlay0 hover:bg-ctp-surface1 sm:w-40"
      >
        <BookOpen class="h-4 w-4" />
        <span>instance rules</span>
      </a>

      <a
        href="upload"
        class="flex h-11 w-full items-center justify-center gap-2 rounded-lg border border-ctp-surface1 bg-ctp-surface0 px-4 text-center transition-colors hover:border-ctp-overlay0 hover:bg-ctp-surface1 sm:w-40"
      >
        <ArrowUpRight class="h-4 w-4" />
        <span>upload files...</span>
      </a>
    </div>
  </div>
</Main>
