---
import Main from "../layouts/main.astro";
import { Upload, TriangleAlert, File as FileIcon } from "@lucide/astro";
import { validateSession, getPageClientIp } from "../server/session";

const session = validateSession(Astro.request, Astro.cookies, getPageClientIp(Astro.request));
if (!session) return Astro.redirect("/login");
---

<Main title="tadpole - upload">
  <div class="flex w-full max-w-xl flex-1 flex-col items-center justify-center py-20 text-center">
    <h1 class="bg-linear-50 bg-clip-text pb-[0.25em] pr-[0.08em] font-besley text-5xl font-bold italic leading-none tracking-tight text-transparent from-ctp-green to-ctp-teal sm:text-6xl">upload</h1>
    <p class="mt-3 max-w-xl text-base font-normal leading-relaxed text-ctp-subtext0 sm:text-lg">drop files anywhere below, or browse your device.</p>

    <div
      id="upload-error"
      class="mt-6 hidden w-full items-start gap-2 rounded-lg border border-ctp-red/40 bg-ctp-red/10 px-4 py-3 text-left text-sm font-normal"
    >
      <TriangleAlert class="mt-0.5 h-4 w-4 shrink-0 text-ctp-red" />
      <p
        id="upload-error-text"
        class="min-w-0 flex-1 break-words text-ctp-text"
      ></p>
    </div>

    <label
      id="drop-zone"
      for="file-input"
      class="mt-6 flex w-full cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-ctp-surface1 bg-ctp-surface0 px-6 py-14 transition-colors hover:border-ctp-overlay0 hover:bg-ctp-surface1 focus-within:border-ctp-overlay0 has-[input:focus-visible]:outline has-[input:focus-visible]:outline-2 has-[input:focus-visible]:outline-ctp-green"
    >
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-ctp-surface1 text-ctp-subtext0">
        <Upload class="h-6 w-6" />
      </span>
      <span class="mt-2 text-base font-medium text-ctp-text">drag &amp; drop files here</span>
      <span class="text-sm font-normal text-ctp-subtext0">or</span>
      <span class="flex h-11 items-center justify-center gap-2 rounded-lg border border-ctp-surface1 bg-ctp-surface0 px-4 text-center text-ctp-text">
        <FileIcon class="h-4 w-4" />
        <span>browse files...</span>
      </span>
      <span class="mt-1 text-sm font-normal text-ctp-subtext0">any file · up to 256 MB each</span>
      <input
        id="file-input"
        class="sr-only"
        type="file"
        multiple
      />
    </label>

    <div
      id="queue-wrap"
      class="mt-4 hidden w-full text-left"
    >
      <div class="flex items-center justify-between gap-3 px-1">
        <p class="text-sm font-normal text-ctp-subtext0">
          <span
            id="queue-count"
            class="font-medium text-ctp-text"
          >0</span> uploading
        </p>
        <button
          id="queue-clear"
          type="button"
          class="text-sm font-normal text-ctp-subtext0 underline-offset-4 transition-colors hover:text-ctp-text hover:underline"
        >
          clear finished
        </button>
      </div>
      <ul
        id="preview"
        class="mt-2 flex w-full flex-col gap-2"
      ></ul>
    </div>

    <a
      href="/"
      class="mt-6 text-sm font-normal text-ctp-subtext0 underline-offset-4 transition-colors hover:text-ctp-text hover:underline"
    >
      back home
    </a>
  </div>
</Main>

<script src="../utils/upload.ts"></script>
